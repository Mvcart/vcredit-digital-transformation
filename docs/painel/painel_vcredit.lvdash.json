{
  "datasets": [
    {
      "name": "55457e9d",
      "displayName": "qualidade_tabelas",
      "queryLines": [
        "SELECT * FROM rocket_lab.vcredit_gold.qualidade_tabelas"
      ]
    },
    {
      "name": "923774a0",
      "displayName": "qualidade_indicadores",
      "queryLines": [
        "SELECT * FROM rocket_lab.vcredit_gold.qualidade_indicadores"
      ]
    },
    {
      "name": "9fd980e3",
      "displayName": "tempo_registrado_real",
      "queryLines": [
        "SELECT canal,\r\n",
        "       ROUND(AVG(tempo_atendimento) / 60, 1) AS atendimento_registrado_min,\r\n",
        "       ROUND(AVG(atend_seg) / 60, 1)         AS atendimento_real_min,\r\n",
        "       ROUND(AVG(CASE WHEN NOT abandono THEN tempo_espera END) / 60, 1) AS espera_registrada_min,\r\n",
        "       ROUND(AVG(espera_seg) / 60, 1)        AS espera_real_min\r\n",
        "FROM rocket_lab.vcredit_gold.chamados_nota\r\n",
        "WHERE canal IN ('atendimento inicial', 'atendimento especializado')\r\n",
        "GROUP BY canal"
      ]
    },
    {
      "name": "355a2ecc",
      "displayName": "indicadores_mensais",
      "queryLines": [
        "SELECT * FROM rocket_lab.vcredit_gold.indicadores_mensais"
      ]
    },
    {
      "name": "5c97948d",
      "displayName": "satisfacao_mensal",
      "queryLines": [
        "SELECT mes,\r\n",
        "       ROUND(AVG(nota), 2) AS nota_media,\r\n",
        "       ROUND(AVG(CASE WHEN tem_nota THEN 1 ELSE 0 END) * 100, 1) AS taxa_resposta_pct\r\n",
        "FROM rocket_lab.vcredit_gold.chamados_nota\r\n",
        "WHERE mes IS NOT NULL\r\n",
        "GROUP BY mes\r\n",
        "ORDER BY mes"
      ]
    }
  ],
